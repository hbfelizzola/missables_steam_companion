{
  "name": "missables-tracker",
  "version": "0.1.0",
  "description": "Decky plugin to track missable and optional content for supported games.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "parse:ffix": "python3 scripts/parse_ffix_guide.py",
    "parse:ffvii": "python3 scripts/parse_ffvii_guide.py",
    "parse:ffx": "python3 scripts/parse_ffx_guide.py",
    "parse:all": "python3 scripts/parse_ffvii_guide.py && python3 scripts/parse_ffix_guide.py && python3 scripts/parse_ffx_guide.py",
    "package": "bash scripts/package-plugin.sh",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/humberto/missables_steam_companion.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "missables",
    "final-fantasy"
  ],
  "author": "Humberto",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
